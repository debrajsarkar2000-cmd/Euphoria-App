{
  "appId": "com.euphorialiveclasses.app",
  "appName": "Euphoria Live Classes",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PrivacyScreen": {
      "enable": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0c203b",
      "showSpinner": false
    }
  }
}
